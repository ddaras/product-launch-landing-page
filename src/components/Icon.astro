---
interface Props {
  name: 'arrow' | 'spark' | 'layers' | 'people' | 'path' | 'plus';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  spark: 'm12 3 2.3 6.7L21 12l-6.7 2.3L12 21l-2.3-6.7L3 12l6.7-2.3L12 3Z',
  layers: 'm12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  people:
    'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z',
  path: 'M5 4v12a4 4 0 0 0 4 4h6a4 4 0 0 0 0-8H9m3-3-3 3 3 3M3 4h4',
  plus: 'M12 5v14M5 12h14',
};
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
